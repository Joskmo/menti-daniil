BRIDGE_DOMAIN=menti-github.jos-dev.ru
YONOTE_BASE_URL=https://joskmo.yonote.ru
YONOTE_API_KEY=replace-me
# Generate each webhook secret independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
GITHUB_WEBHOOK_SECRET=replace-me
YONOTE_WEBHOOK_PATH_SECRET=replace-me
GITHUB_REPOSITORY=Joskmo/menti-daniil
GITHUB_BASE_BRANCH=main
# Both assignees trigger branch creation: learner and mentor/owner.
YONOTE_ASSIGNEE_ID=632a8b92-3611-477b-b6d6-b5a0df87e57e
YONOTE_MENTOR_ASSIGNEE_ID=b5b7f053-07c2-4008-8b1b-72eeab60724a
POLL_INTERVAL_SECONDS=15
DATABASE_PATH=/data/bridge.db
# Enable only with the isolated grader profile.
# GRADER_DATABASE_PATH=/grader-state/grader.db
# GRADER_DATABASE_DIR=/home/you/.local/share/menti-grader/state
# GRADER_SUITE_VAULT_PATH=/suite-vault
# GRADER_SUITE_VAULT_DIR=/home/you/.local/share/menti-grader/vault
# GRADER_GIT_REPOSITORY=https://github.com/Joskmo/menti-daniil.git
# GRADER_GIT_CACHE_PATH=/git-cache/repository.git
# GRADER_GIT_CACHE_DIR=/home/you/.local/share/menti-grader/git-cache
# GRADER_LAUNCHER_SOCKET=/run/menti-launcher/launcher.sock
# GRADER_LAUNCHER_RUN_DIR=/home/you/.local/share/menti-grader/run/launcher
# GRADER_LLM_BROKER_SOCKET=/run/menti-broker/llm-broker.sock
# GRADER_BROKER_RUN_DIR=/home/you/.local/share/menti-grader/run/broker
# KVM_GID=993
# GITHUB_APP_ID=replace-me
# GITHUB_APP_INSTALLATION_ID=replace-me
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
# For a two-user MVP, the host-side publisher can use an existing OAuth/PAT instead.
# GITHUB_TOKEN=replace-me
# GITHUB_REPOSITORY_OWNER=Joskmo
# GITHUB_REPOSITORY_NAME=menti-daniil
# Separate interactive BotFather bot for mentor approval, grade reports and code feedback.
# MENTI_TELEGRAM_BOT_TOKEN=replace-me
# MENTI_TELEGRAM_CHAT_ID=replace-me
# MENTI_TELEGRAM_USER_ID=replace-me
# MENTI_TELEGRAM_STATE_PATH=/menti-data/bot.db
# MENTI_BOT_DATA_DIR=/home/you/.local/share/menti-grader/menti-bot
# Do not run grader.hermes_report_worker_cli alongside menti-grader-bot:
# both consume the same durable grade-notification queue.
GIT_DIR=/data/repository.git
